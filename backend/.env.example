# PostgreSQL connection string
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kos_finder

# Google Maps API key (server-side ONLY)
# ⚠️ Restrict key by IP di Google Cloud Console. JANGAN pernah diekspos ke browser/frontend.
GOOGLE_MAPS_API_KEY=your_api_key_here

# Overpass API endpoint (OpenStreetMap). Opsional, default: overpass-api.de
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Nominatim geocoding endpoint. Opsional, default: nominatim.openstreetmap.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
