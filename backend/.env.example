# PostgreSQL connection string
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kos_finder

# CORS origins yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000

# Google Maps API key (server-side ONLY)
# ⚠️ Restrict key by IP di Google Cloud Console. JANGAN pernah diekspos ke browser/frontend.
GOOGLE_MAPS_API_KEY=your_api_key_here

# ── Scrape coverage tuning ──────────────────────────────────────────────
# Kota dipecah menjadi NxN sel area; tiap sel dicari dengan SEMUA keyword di
# bawah ini (hasil antar sel/keyword di-dedup per place_id).
#   - SCRAPE_GRID_SIZE   : ukuran grid (2 = 2x2 = 4 sel, 3 = 9 sel)
#   - SCRAPE_KEYWORDS    : varian keyword, dipisah koma
#   - SCRAPE_MAX_PAGES   : maks halaman pagination per query (maks 5; 20 hasil/halaman)
#   - SCRAPE_CONCURRENCY : jumlah request paralel (jangan terlalu tinggi vs quota Google)
SCRAPE_GRID_SIZE=2
SCRAPE_KEYWORDS=kos,kost,kosan,indekos,rumah kos
SCRAPE_MAX_PAGES=3
SCRAPE_CONCURRENCY=6

# Overpass API endpoint (OpenStreetMap). Opsional, default: overpass-api.de
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Nominatim geocoding endpoint. Opsional, default: nominatim.openstreetmap.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
